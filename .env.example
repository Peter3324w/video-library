# Accounts and sync for the web build (npm run dev:web / build:web).
# Copy to .env.local and fill in from your Supabase project's API settings.
# Both values are public by design: they ship in the page, and the table is
# protected by row-level security (supabase/schema.sql), not by hiding these.
# Leave them out and the web build simply has no accounts.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set to 1 once the Google provider is switched on in Supabase (Auth > Providers).
VITE_AUTH_GOOGLE=0
